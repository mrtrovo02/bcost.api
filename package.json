{
  "name": "bcost-api",
  "version": "0.1.0",
  "description": "Bcost API",
  "main": "dist/main.js",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rimraf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-old-space-size=1024 dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:seed": "node scripts/run-prisma-seed.cjs",
    "provision:company": "node scripts/provision-production-company.cjs",
    "runtime:check": "node scripts/check-node-runtime.cjs",
    "release:check": "node scripts/validate-production-env.cjs",
    "security:scan": "node scripts/check-versioned-secrets.cjs",
    "audit:production-risk": "node scripts/check-production-audit-baseline.cjs",
    "smoke:production": "node scripts/smoke-production.cjs",
    "smoke:authenticated": "node scripts/smoke-authenticated.cjs",
    "deploy:verify": "node scripts/verify-deploy-state.cjs",
    "ops:ec2-check": "node scripts/ec2-operational-check.cjs",
    "predeploy:code": "node scripts/predeploy-check.cjs --code-only",
    "predeploy:check": "node scripts/predeploy-check.cjs",
    "predeploy:full": "node scripts/predeploy-check.cjs --with-build",
    "infra:local": "docker compose -f docker-compose.local.yml up -d postgres redis",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:auth-session": "jest --runInBand src/auth/guards/jwt-auth.guard.spec.ts src/auth/auth.controller.security.spec.ts src/auth/guards/tenant-context.guard.spec.ts",
    "test:http-contract": "jest --runInBand src/common/config/http-runtime.config.spec.ts src/common/config/cors-headers.config.spec.ts src/test/app.e2e-spec.ts",
    "test:observability": "jest --runInBand src/common/interceptors/logging.interceptor.spec.ts src/common/logger/logger-redaction.config.spec.ts src/common/logger/logger.module.spec.ts src/common/filters/global-exception.filter.spec.ts src/modules/health/metrics-access.util.spec.ts src/modules/health/metrics.controller.spec.ts",
    "test:security": "jest --runInBand src/modules/finance/finance.controller.security.spec.ts src/modules/enterprise/enterprise-tenant-guards.spec.ts src/modules/banking/banking.service.security.spec.ts src/auth/auth.controller.security.spec.ts src/auth/guards/tenant-context.guard.spec.ts",
    "test:tax-scenarios": "jest --runInBand src/modules/tax-scenarios/tax-scenarios.service.spec.ts",
    "test:release-gates": "jest --runInBand src/release",
    "test:rls": "jest --runInBand src/database/prisma.rls.integration.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "overrides": {
    "@fastify/middie": "^8.3.3",
    "cross-spawn": "^7.0.5",
    "tar": "^7.5.22",
    "lodash": "^4.17.21",
    "fastify": "^4.29.1",
    "fast-xml-parser": "^5.11.1",
    "body-parser": "^1.20.6",
    "picomatch": "^3.0.1",
    "js-yaml": "^4.3.2",
    "multer": "1.4.5-lts.1",
    "qs": "^6.16.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/cache-manager": "2.3.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "10.4.22",
    "@nestjs/event-emitter": "2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-fastify": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "5.2.0",
    "@nestjs/websockets": "10.4.22",
    "@peculiar/x509": "^2.0.0",
    "@prisma/adapter-pg": "^5.13.0",
    "@prisma/client": "^5.13.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "bullmq": "^5.7.10",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^4.29.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^17.13.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^3.0.0",
    "ofx-js": "^0.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.4.22",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.5.0",
    "@types/bcrypt": "^5.0.2",
    "@types/decimal.js": "^0.0.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.3.0",
    "prettier": "^3.2.5",
    "prisma": "^5.13.0",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!main.ts",
      "!seed.ts",
      "!redis.config.ts",
      "!**/node_modules/**",
      "!**/database/prisma/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#common/(.*)\\.js$": "<rootDir>/common/$1",
      "^#database/(.*)\\.js$": "<rootDir>/database/$1",
      "^#auth/(.*)\\.js$": "<rootDir>/auth/$1",
      "^#modules/(.*)\\.js$": "<rootDir>/modules/$1",
      "^#shared/(.*)\\.js$": "<rootDir>/shared/$1",
      "^#common/(.*)$": "<rootDir>/common/$1",
      "^#database/(.*)$": "<rootDir>/database/$1",
      "^#auth/(.*)$": "<rootDir>/auth/$1",
      "^#modules/(.*)$": "<rootDir>/modules/$1",
      "^#shared/(.*)$": "<rootDir>/shared/$1",
      "^#/(.*)\\.js$": "<rootDir>/$1",
      "^#/(.*)$": "<rootDir>/$1",
      "^src/(.*)\\.js$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
