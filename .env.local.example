# Ambiente local com docker-compose.local.yml
NODE_ENV=development
PORT=5000

# Database local Postgres + pgvector
DATABASE_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost
DIRECT_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost

# Redis local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bcost_redis_dev

# Auth
JWT_SECRET=change-me-min-32-chars-local-dev-only
FISCAL_API_KEY=local-fiscal-api-key-change-me
ALLOW_SETUP_ADMIN=false
SETUP_ADMIN_PASSWORD=

# App URLs
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Payments / Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Demo controlada
ENABLE_DEMO_FALLBACK=true
ALLOW_DEMO_SESSION=true

# Swagger & CORS
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
