# Ambiente local com docker-compose.local.yml
NODE_ENV=development
PORT=5000

# Database local Postgres + pgvector
DATABASE_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost
DIRECT_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost

# Redis local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bcost_redis_dev

# Auth
JWT_SECRET=change-me-min-32-chars-local-dev-only
FISCAL_API_KEY=local-fiscal-api-key-change-me
# Use true somente em setup local controlado. Em EC2/producao deve permanecer false.
ALLOW_SETUP_ADMIN=false
SETUP_ADMIN_PASSWORD=

# App URLs
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# EC2/producao deve usar HTTPS:
# FRONTEND_BASE_URL=https://app.bcost.com.br
# PUBLIC_APP_URL=https://app.bcost.com.br

# Payments / Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Demo controlada
# Em producao, sessao demo exige token demo e header x-demo-session=true.
ENABLE_DEMO_FALLBACK=true
ALLOW_DEMO_SESSION=true

# Swagger & CORS
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# EC2/producao:
# ENABLE_SWAGGER=false
# CORS_ORIGINS=https://bcost.com.br,https://www.bcost.com.br,https://app.bcost.com.br

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
