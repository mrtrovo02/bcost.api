import { Injectable, Logger } from '@nestjs/common';
import { PrismaService } from '../../database/prisma.service.js';
import { AuditProducer } from '../../common/audit/audit.producer.js';

@Injectable()
export class ReconciliationService {
  private readonly logger = new Logger(ReconciliationService.name);

  constructor(
    private readonly prisma: PrismaService,
    private readonly auditProducer: AuditProducer,
  ) {}

  async reconcileTransaction(companyId: string, data: any, userId: string) {
    return await this.prisma.$transaction(async (tx) => {
      // 1. Lógica de Negócio (Exemplo)
      const result = await tx.bankTransaction.update({
        where: { id: data.id },
        data: { reconciled: true },
      });

      // 2. Auditoria Desacoplada (Não trava a transação do banco!)
      this.auditProducer.dispatch({
        action: 'RECONCILE',
        module: 'banking',
        entity: 'transaction',
        entityId: result.id,
        userId,
        companyId,
        payload: { transactionId: data.id },
      });

      return result;
    });
  }
}
