// =============================================================================
// ARQUIVO: prisma/schema.prisma
// bCost Engine — Schema Enterprise 2026
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions", "driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_stat_statements, pgcrypto, uuid_ossp(map: "uuid-ossp"), vector]
}

// =============================================================================
// USUÁRIOS E SESSÕES
// =============================================================================

model User {
  id                         String            @id @default(uuid())
  email                      String            @unique
  password                   String
  name                       String
  active                     Boolean           @default(true)
  twoFactor                  Boolean           @default(false)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  deletedAt                  DateTime?
  logs                       AuditLog[]
  companies                  CompanyUser[]
  acknowledgerNotifications  NotificationLog[] @relation("notification_acknowledger")
  recipientNotifications     NotificationLog[] @relation("notification_recipient")
  sessions                   UserSession[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// =============================================================================
// EMPRESA
// =============================================================================

model Company {
  id                  String               @id @default(uuid())
  cnpj                String               @unique
  name                String
  taxRegime           TaxRegime            @default(SIMPLES_NACIONAL)
  anexo               Int                  @default(3)
  cnae                String?
  cnae2               String?
  municipalCode       String?
  active              Boolean              @default(true)
  planLevel           String               @default("FREE")
  lastSyncAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  version             Int                  @default(1)
  settings            Json?                @default("{}")
  
  logs                AuditLog[]
  automationJobs      AutomationJob[]
  balanceLocks        BalanceLock[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  businessRules       BusinessRule[]
  cashFlowProjections CashFlowProjection[]
  users               CompanyUser[]
  complianceChecks    ComplianceCheck[]
  contracts           Contract[]
  customers           Customer[]
  certificates        DigitalCertificate[]
  financialEvents     FinancialEvent[]
  financialSnapshots  FinancialSnapshot[]
  invoices            Invoice[]
  notifications       NotificationLog[]
  payrolls            Payroll[]
  taxCalculations     TaxCalculation[]
  taxObligations      TaxObligation[]
  webhooks            WebhookConfig[]
  employees           Employee[]
  accountingEntries   AccountingEntry[]
  fiscalObligations   FiscalObligation[]
  accountPlans        AccountPlan[]

  @@index([cnpj])
  @@index([active])
  @@map("companies")
}

model CompanyUser {
  id        String      @id @default(uuid())
  userId    String
  companyId String
  role      CompanyRole @default(VIEWER)
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@map("company_users")
}

// =============================================================================
// FISCAL — NOTAS FISCAIS
// =============================================================================

model Invoice {
  id              String                 @id @default(uuid())
  companyId       String
  customerId      String
  type            InvoiceType
  status          InvoiceStatus          @default(NORMAL)
  nfeStatus       NFeStatus              @default(DRAFT)
  amount          Decimal                @db.Decimal(18, 2)
  taxAmount       Decimal?               @db.Decimal(18, 2)
  issuedAt        DateTime
  accessKey       String?                @unique
  number          String?
  serie           String?                @default("1")
  xmlUrl          String?
  reconciled      Boolean                @default(false)
  version         Int                    @default(1)
  vectorData      Unsupported("vector")?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  
  bankTransaction BankTransaction?       @relation("InvoiceBankTransaction")
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer               @relation(fields: [customerId], references: [id])
  sefazEvents     InvoiceSefazEvent[]

  @@unique([companyId, accessKey])
  @@index([companyId, issuedAt])
  @@index([companyId, status, type])
  @@index([companyId, nfeStatus])
  @@map("invoices")
}

model InvoiceSefazEvent {
  id         String     @id @default(uuid())
  invoiceId  String
  event      SefazEvent
  protocol   String?
  statusCode String?
  message    String?
  occurredAt DateTime   @default(now())
  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, event])
  @@index([invoiceId, occurredAt])
  @@map("invoice_sefaz_events")
}

// =============================================================================
// BANCÁRIO
// =============================================================================

model BankTransaction {
  id              String           @id @default(uuid())
  companyId       String
  bankAccountId   String
  reconciled      Boolean          @default(false)
  invoiceId       String?          @unique
  taxObligationId String?          @unique
  type            TransactionType
  amount          Decimal          @db.Decimal(18, 2)
  description     String
  occurredAt      DateTime
  metadata        Json?
  createdAt       DateTime         @default(now())
  version         Int              @default(1)
  
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice         Invoice?         @relation("InvoiceBankTransaction", fields: [invoiceId], references: [id])
  taxObligation   TaxObligation?   @relation("TaxObligationBankTransaction", fields: [taxObligationId], references: [id])

  @@index([companyId, occurredAt])
  @@index([bankAccountId, reconciled])
  @@index([companyId, reconciled])
  @@map("bank_transactions")
}

model BankAccount {
  id           String            @id @default(uuid())
  companyId    String
  bankName     String
  agency       String
  account      String
  balanceCache Decimal           @default(0) @db.Decimal(18, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BalanceLock {
  id        String   @id @default(uuid())
  companyId String
  month     Int
  year      Int
  lockedAt  DateTime @default(now())
  lockedBy  String
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, month, year])
  @@map("balance_locks")
}

// =============================================================================
// CLIENTES E CONTRATOS
// =============================================================================

model Customer {
  id        String     @id @default(uuid())
  companyId String
  name      String
  document  String
  email     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  contracts Contract[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([companyId, document])
  @@index([name])
  @@index([companyId])
  @@map("customers")
}

model Contract {
  id            String         @id @default(uuid())
  companyId     String
  customerId    String
  description   String
  amount        Decimal        @db.Decimal(18, 2)
  billingDay    Int            @default(5)
  status        ContractStatus @default(ACTIVE)
  lastBillingAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  version       Int            @default(1)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id])

  @@index([companyId, status])
  @@index([billingDay])
  @@map("contracts")
}

// =============================================================================
// OBRIGAÇÕES TRIBUTÁRIAS
// =============================================================================

model TaxObligation {
  id              String           @id @default(uuid())
  companyId       String
  name            String
  dueDate         DateTime
  amount          Decimal          @db.Decimal(18, 2)
  status          ObligationStatus @default(PENDING)
  fileUrl         String?
  createdAt       DateTime         @default(now())
  version         Int              @default(1)
  
  bankTransaction BankTransaction? @relation("TaxObligationBankTransaction")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, dueDate])
  @@map("tax_obligations")
}

model TaxCalculation {
  id          String   @id @default(uuid())
  companyId   String
  month       Int
  year        Int
  totalAmount Decimal  @db.Decimal(18, 2)
  rbt12       Decimal? @db.Decimal(18, 2)
  fatorR      Float?
  inputSnapshot Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month, year])
  @@map("tax_calculations")
}

model FiscalObligation {
  id             String                 @id @default(uuid())
  companyId      String
  type           FiscalObligationType
  referenceMonth Int
  referenceYear  Int
  dueDate        DateTime
  status         FiscalObligationStatus @default(PENDING)
  fileUrl        String?
  fileHash       String?
  submittedAt    DateTime?
  receiptCode    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, referenceMonth, referenceYear])
  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@map("fiscal_obligations")
}

// =============================================================================
// FOLHA DE PAGAMENTO
// =============================================================================

model Employee {
  id             String         @id @default(uuid())
  companyId      String
  name           String
  cpf            String
  pis            String?
  admissionAt    DateTime
  dismissalAt    DateTime?
  role           String
  baseSalary     Decimal        @db.Decimal(18, 2)
  active         Boolean        @default(true)
  regime         EmployeeRegime @default(CLT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollEntries PayrollEntry[]

  @@unique([companyId, cpf])
  @@index([companyId, active])
  @@map("employees")
}

model Payroll {
  id              String         @id @default(uuid())
  companyId       String
  month           Int
  year            Int
  salariesAmount  Decimal        @default(0) @db.Decimal(18, 2)
  proLaboreAmount Decimal        @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal        @db.Decimal(18, 2)
  createdAt       DateTime       @default(now())
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries         PayrollEntry[]

  @@unique([companyId, month, year])
  @@index([companyId, year, month])
  @@map("payrolls")
}

model PayrollEntry {
  id               String   @id @default(uuid())
  payrollId        String
  employeeId       String
  baseSalary       Decimal  @db.Decimal(18, 2)
  inssEmployee     Decimal  @default(0) @db.Decimal(18, 2)
  inssEmployer     Decimal  @default(0) @db.Decimal(18, 2)
  irrf             Decimal  @default(0) @db.Decimal(18, 2)
  fgts             Decimal  @default(0) @db.Decimal(18, 2)
  otherBenefits    Decimal  @default(0) @db.Decimal(18, 2)
  otherDeductions  Decimal  @default(0) @db.Decimal(18, 2)
  netSalary        Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  employee         Employee @relation(fields: [employeeId], references: [id])
  payroll          Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@map("payroll_entries")
}

// =============================================================================
// CONTABILIDADE
// =============================================================================

model AccountPlan {
  id          String      @id @default(uuid())
  companyId   String?
  code        String
  name        String
  type        AccountType
  parentCode  String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([type])
  @@index([parentCode])
  @@map("account_plans")
}

model AccountingEntry {
  id            String      @id @default(uuid())
  companyId     String
  date          DateTime
  description   String
  debitCode     String
  creditCode    String
  amount        Decimal     @db.Decimal(18, 2)
  origin        EntryOrigin @default(MANUAL)
  referenceId   String?
  referenceType String?
  month         Int
  year          Int
  locked        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, month, year])
  @@index([debitCode])
  @@index([creditCode])
  @@index([referenceId, referenceType])
  @@map("accounting_entries")
}

// =============================================================================
// FINANCEIRO
// =============================================================================

model FinancialEvent {
  id            String             @id @default(uuid())
  companyId     String
  type          FinancialEventType
  amount        Decimal            @db.Decimal(18, 2)
  description   String
  referenceId   String?
  referenceType String?
  month         Int
  year          Int
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime           @default(now())
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, occurredAt])
  @@index([companyId, month, year])
  @@index([referenceId, referenceType])
  @@map("financial_events")
}

model FinancialSnapshot {
  id            String   @id @default(uuid())
  companyId     String
  month         Int
  year          Int
  revenue       Decimal  @db.Decimal(18, 2)
  expenses      Decimal  @db.Decimal(18, 2)
  taxPayable    Decimal  @db.Decimal(18, 2)
  netProfit     Decimal  @db.Decimal(18, 2)
  fatorRData    Json?
  integrityHash String   @unique
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, month])
  @@map("financial_snapshots")
}

model CashFlowProjection {
  id             String   @id @default(uuid())
  companyId      String
  projectionDate DateTime @map("projection_date")
  data           Json
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, projectionDate])
  @@map("cash_flow_projections")
}

// =============================================================================
// AUDITORIA
// =============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  module       String
  entity       String?
  entityId     String?
  payload      Json?
  statusCode   Int?
  responseTime Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  userId       String?
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// =============================================================================
// NOTIFICAÇÕES
// =============================================================================

model NotificationLog {
  id               String               @id @default(uuid())
  companyId        String
  userId           String?
  type             NotificationType
  title            String
  message          String
  channel          NotificationChannel  @default(WEBSOCKET)
  status           NotificationStatus   @default(PENDING)
  severity         NotificationSeverity @default(INFO)
  read             Boolean              @default(false)
  readAt           DateTime?
  acknowledged     Boolean              @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  metadata         Json?
  createdAt        DateTime             @default(now())
  sentAt           DateTime?
  
  acknowledger     User?                @relation("notification_acknowledger", fields: [acknowledgedById], references: [id])
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User?                @relation("notification_recipient", fields: [userId], references: [id])

  @@index([companyId, status])
  @@index([userId, read])
  @@index([companyId, severity, status])
  @@map("notification_logs")
}

// =============================================================================
// COMPLIANCE E AUTOMAÇÃO
// =============================================================================

model ComplianceCheck {
  id          String               @id @default(uuid())
  companyId   String
  checkName   String
  severity    NotificationSeverity @default(INFO)
  status      ComplianceStatus     @default(OPEN)
  description String?
  resolved    Boolean              @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, resolved])
  @@index([companyId, severity, resolved])
  @@map("compliance_checks")
}

model AutomationJob {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  type        String?
  status      JobStatus @default(QUEUED)
  progress    Int       @default(0)
  payload     Json?
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status, createdAt])
  @@map("automation_jobs")
}

model BusinessRule {
  id              String    @id @default(uuid())
  companyId       String
  name            String
  description     String?
  condition       Json
  action          Json
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, enabled])
  @@map("business_rules")
}

// =============================================================================
// CERTIFICADOS E WEBHOOKS
// =============================================================================

model DigitalCertificate {
  id           String            @id @default(uuid())
  companyId    String
  issuer       String
  thumbprint   String?
  serialNumber String?
  validFrom    DateTime
  validTo      DateTime
  status       CertificateStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, validTo])
  @@index([companyId, status])
  @@map("digital_certificates")
}

model WebhookConfig {
  id        String   @id @default(uuid())
  companyId String
  url       String
  events    String[]
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
  @@map("webhook_configs")
}

// =============================================================================
// ENUMS
// =============================================================================

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum InvoiceType {
  SERVICE
  PRODUCT
  PURCHASE
}

enum InvoiceStatus {
  NORMAL
  CANCELLED
  SUBSTITUTED
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum CompanyRole {
  OWNER
  ACCOUNTANT
  MANAGER
  VIEWER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum CertificateStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum NotificationType {
  TAX_READY
  FACTOR_R_ALERT
  COMPLIANCE_ISSUE
  CERT_EXPIRATION
  PAYMENT_OVERDUE
  PREDICTIVE_CASHFLOW_ALERT
  DAS_OVERDUE
  SPED_DUE
  ECF_DUE
  ECAC_PENDENCY
  EMPLOYEE_DISMISSAL_DUE
}

enum NotificationChannel {
  WEBSOCKET
  EMAIL
  SMS
  WHATSAPP
  PUSH
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRY
  READ
  ARCHIVED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ObligationStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
  FINISHED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ComplianceStatus {
  OPEN
  RESOLVED
  IGNORED
  IN_PROGRESS
}

enum FinancialEventType {
  INVOICE_ISSUED
  INVOICE_CANCELLED
  PAYMENT_RECEIVED
  TAX_PAID
  PAYROLL_PAID
  MANUAL_ADJUSTMENT
  BANK_SYNC
}

enum NFeStatus {
  DRAFT
  PENDING_AUTHORIZATION
  AUTHORIZED
  DENIED
  CANCELLED
  VOIDED
  CONTINGENCY
}

enum SefazEvent {
  AUTORIZADA
  DENEGADA
  CANCELADA
  INUTILIZADA
  EM_CONTINGENCIA
  CONTINGENCIA_RESOLVIDA
  CARTA_CORRECAO
  EPEC
}

enum EmployeeRegime {
  CLT
  PJ
  ESTAGIO
  AUTONOMO
  SOCIO_ADMINISTRADOR
}

enum EntryOrigin {
  MANUAL
  INVOICE_AUTO
  PAYROLL_AUTO
  BANK_IMPORT
  TAX_PAYMENT
}

enum FiscalObligationType {
  DAS
  GPS
  DARF
  SPED_FISCAL
  SPED_CONTRIBUICOES
  ECD
  ECF
  DCTF
  RAIS
  CAGED
  DIRF
  DEFIS
  PGDAS
}

enum FiscalObligationStatus {
  PENDING
  GENERATED
  SUBMITTED
  ACCEPTED
  REJECTED
  OVERDUE
}

enum AccountType {
  ATIVO
  PASSIVO
  PATRIMONIO_LIQUIDO
  RECEITA
  DESPESA
  CUSTO
}
