{
  "compilerOptions": {
    /* 1. Infraestrutura de Módulos (ESM / NodeNext) */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "rootDir": "src",
    "outDir": "./dist",

    /* 2. Suporte a DTOs e Classes */
    "strict": true, 
    "strictPropertyInitialization": false,
    "strictNullChecks": true,
    "noImplicitAny": false,

    /* 3. Arquitetura de Caminhos (Aliases) */
    /* Removido o wildcard '#' que pode conflitar com subpath imports nativos se não configurado no loader */
    "paths": {
      "#common/*": ["./src/common/*"],
      "#database/*": ["./src/database/*"],
      "#auth/*": ["./src/auth/*"],
      "#modules/*": ["./src/modules/*"],
      "#shared/*": ["./src/shared/*"],
      "#/*": ["./src/*"]
    },

    /* 4. Funcionalidades NestJS & Decorators (Obrigatório) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* 5. Performance e Compilação */
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": true,
    "isolatedModules": true,
    /* Essencial para que o TS entenda o campo 'exports' das bibliotecas modernas */
    "resolvePackageJsonExports": true,

    /* 6. Robustez de Código */
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "declaration": false,
    "pretty": true,

    /* 7. Compatibilidade e Verificação */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true,
    /* Garante que o build não falhe por imports de tipos em ESM */
    "verbatimModuleSyntax": false 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
