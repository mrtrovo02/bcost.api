# Ambiente
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost
DIRECT_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bcost_redis_dev

# Auth
JWT_SECRET=change-me-min-32-chars
FISCAL_API_KEY=
# CRITICO: nunca use ALLOW_SETUP_ADMIN=true em producao.
# O setup inicial de admin em producao deve ser feito por runbook operacional
# controlado, secret manager ou migration auditada.
ALLOW_SETUP_ADMIN=false
SETUP_ADMIN_PASSWORD=

# App URLs
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Payments / Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Demo controlada
# Em producao, mantenha false para ambientes de cliente real.
# Use true somente quando o front publico precisar expor a sessao demo.
ENABLE_DEMO_FALLBACK=false
ALLOW_DEMO_SESSION=false

# Swagger & CORS
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
