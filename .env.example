# Ambiente
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost
DIRECT_URL=postgresql://bcost:bcost_dev_password@localhost:5432/bcost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bcost_redis_dev

# Auth
JWT_SECRET=change-me-min-32-chars
FISCAL_API_KEY=
# CRITICO: nunca habilite ALLOW_SETUP_ADMIN em producao.
# O setup inicial de admin em producao deve ser feito por runbook operacional
# controlado, secret manager ou migration auditada.
ALLOW_SETUP_ADMIN=false
SETUP_ADMIN_PASSWORD=

# App URLs
# Local:
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Producao EC2:
# FRONTEND_BASE_URL=https://app.bcost.com.br
# PUBLIC_APP_URL=https://app.bcost.com.br

# Payments / Stripe
# STRIPE_SECRET_KEY deve ser sk_test_ em homologacao ou sk_live_ em producao.
# Nunca use pk_test_/pk_live_ no backend; chaves pk_* sao publicaveis.
# STRIPE_WEBHOOK_SECRET vem do endpoint webhook Stripe e inicia com whsec_.
# STRIPE_PRICE_* deve usar o Price ID iniciado por price_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Demo controlada
# Em producao, mantenha false para ambientes de cliente real.
# Use a demo publica somente com usuario e empresa reais provisionados para demonstracao.
# O backend nao aceita bypass demonstrativo quando NODE_ENV=production.
ENABLE_DEMO_FALLBACK=false
ALLOW_DEMO_SESSION=false

# Swagger & CORS
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Producao EC2:
# ENABLE_SWAGGER=false
# CORS_ORIGINS=https://bcost.com.br,https://www.bcost.com.br,https://app.bcost.com.br

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
